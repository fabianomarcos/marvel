  id         Int      @id @default(autoincrement())
  idmodulo   Int?
  limite     String   @db.VarChar(255)
  modulo     String?  @db.VarChar(50)
  alias      String   @db.VarChar(255)
  ordemalias Decimal? @db.Decimal(10, 4)
  crud       String?  @db.VarChar(255)

  @@index([id, limite], map: "idx_1")
}

model usuarioslimitesmodulos {
  id     Int     @id @default(autoincrement())
  modulo String? @db.VarChar(50)
