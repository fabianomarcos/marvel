  editar     String @db.VarChar(3)
  excluir    String @db.VarChar(3)

  @@index([idlimite, idperfil], map: "idx_1")
}

model solicitacao_inscrica_escola {
  id               String @id @default(uuid())
  nome             String
  idcategoria      Int
  cidade           String
  numero_de_alunos Int
}
