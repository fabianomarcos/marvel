  link       String?   @db.VarChar(1000)
  status     String?   @db.VarChar(50)
  excluido   String?   @db.VarChar(3)
  logusuario Int?
  logdata    DateTime? @db.DateTime(0)
}

model posts {
  id         Int       @id @default(autoincrement())
  idparent   Int?
  idarquivo  Int?
  data       DateTime? @db.DateTime(0)
  topico     String?   @db.VarChar(255)
  subtopico  String?   @db.VarChar(500)
  texto      String?   @db.Text
  idimagem   Int?
  idbanner   Int?
  video      String?   @db.Text
  link       String?   @db.VarChar(500)
  ordem      Int?
  destaque   String?   @db.VarChar(20)
  status     String?   @db.VarChar(20)
  excluido   String?   @db.VarChar(3)
  logusuario Int
  logdata    DateTime  @db.DateTime(0)

  @@index([excluido, id, idparent, status], map: "idx_1")
}

