}

model usuarios {
  id                Int       @id @default(autoincrement())
  idfoto            Int?
  idparent          Int?
  idperfil          Int?
  datacriacao       DateTime? @db.DateTime(0)
  nomerazao         String?   @db.VarChar(255)
  sobrenomefantasia String?   @db.VarChar(255)
  email             String?   @db.VarChar(500)
  senha             String?   @db.VarChar(50)
