}

model imagens {
  id             Int       @id @default(autoincrement())
  filename       String?   @db.VarChar(255)
  size           Int?
  ordem          Int?
  logdata        DateTime? @db.DateTime(0)
  logusuario     Int?
  logusuariotipo String?   @db.VarChar(20)
  excluido       String?   @db.VarChar(3)
}

model instituicoes {
  id          Int       @id @default(autoincrement())
  idimagem    Int?
  url_imagem  String?
  titulo      String?   @db.VarChar(500)
  descricoes  String?   @db.Text
  descricoes2 String?   @db.Text
  descricoes3 String?   @db.Text
  bairro      String?   @db.VarChar(500)
  cidade      String?   @db.VarChar(500)
  uf          String?   @db.VarChar(50)
  status      String?   @db.VarChar(50)
  email       String?   @db.VarChar(500)
  senha       String?   @db.VarChar(500)
  excluido    String?   @db.VarChar(3)
  tipo        String?   @db.Char(1)
  logusuario  Int?
  logdata     DateTime? @db.DateTime(0)
  map_url     String?
}

model instituicoes_imagens {
  id             Int     @id @default(autoincrement())
  id_instituicao Int?
